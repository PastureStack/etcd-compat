#!/bin/bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "${repo_root}"

for script in \
    build \
    package/platform-compat/run.sh \
    package/platform-compat/delete \
    package/platform-compat/disaster \
    package/update-platform-ca; do
    bash -n "${script}"
done

required_markers=(
    'FROM ubuntu:${UBUNTU_VERSION}'
    'GO_VERSION=1.26.5'
    'GO_LINUX_AMD64_SHA256=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053'
    'org.opencontainers.image.source="https://github.com/PastureStack/etcd-compat"'
    'org.opencontainers.image.version="v2.3.7-pasturestack.2"'
    'package/platform-compat/run.sh'
    '/opt/pasturestack/run.sh'
    'PLATFORM_METADATA_URL'
    'PLATFORM_ACCESS_KEY'
    'PLATFORM_SECRET_KEY'
    'ETCD_HEALTHCHECK_SERVER_NAME'
    'PastureStack is an independent community effort to preserve, audit, and modernize the Rancher 1.6 ecosystem. It is not affiliated with or endorsed by Rancher Labs or SUSE.'
)

for marker in "${required_markers[@]}"; do
    if ! grep -R -Fq "${marker}" \
        Dockerfile README.md PASTURESTACK_MAINTENANCE.md package scripts; then
        echo "ETCD_COMPAT_REQUIRED_MARKER_MISSING marker=${marker}" >&2
        exit 1
    fi
done

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    while read -r expected path; do
        actual=$(git hash-object --path="$path" "$path")
        if [ "$actual" != "$expected" ]; then
            echo "ETCD_COMPAT_INHERITED_FIXTURE_CHANGED path=${path}" >&2
            exit 1
        fi
    done <<'EOF'
a15a6abaf78f9818bf937f0df715bc2f5708bba0 Godeps/_workspace/src/golang.org/x/net/http2/h2demo/rootCA.key
f329c1421209cab976f849fd4d6903fafa60dd78 Godeps/_workspace/src/golang.org/x/net/http2/h2demo/server.key
631f398cec6e74a3db01656b77c4b09c540a4171 integration/fixtures/server.key.insecure
EOF
else
    while read -r expected_lf expected_crlf path; do
        actual=$(sha256sum "$path" | awk '{print $1}')
        if [ "$actual" != "$expected_lf" ] && [ "$actual" != "$expected_crlf" ]; then
            echo "ETCD_COMPAT_INHERITED_FIXTURE_CHANGED path=${path}" >&2
            exit 1
        fi
    done <<'EOF'
dfc6849f8ec095eb5476327c5ceb1352682c6160685150f6837230a8197c4dfd 979af8a4415d1ad6a13caed4c314b72b541facabee964a3b74305c43c0a515eb Godeps/_workspace/src/golang.org/x/net/http2/h2demo/rootCA.key
2dccb2e6594986307311639d75601a232c0c0039f6a6f17b6dd417cb61513756 1fec27ed7924704212a2a14a6238264b705634dac62771326b46262736450296 Godeps/_workspace/src/golang.org/x/net/http2/h2demo/server.key
c3419809e3d1eca8a95b90223915f979dab7563cb7722ca2542c1f43e1769326 411b12a35374e3370b8501cb504588601f03d88ad9d96cbab9fdd6e58b7c494d integration/fixtures/server.key.insecure
EOF
fi

if [ "$(grep -c '^[[:space:]]*path:' trivy-secret.yaml)" -ne 2 ]; then
    echo "ETCD_COMPAT_SECRET_ALLOWLIST_SCOPE_CHANGED" >&2
    exit 1
fi

if grep -R -Eiq \
    'C:\\Users\\|/home/[^/[:space:]]+/(pstk|source|rc[0-9]+)|10\.0\.0\.[0-9]{1,3}|rancher-[0-9]+\.[0-9]+-|rc[0-9]+[-_/]' \
    Dockerfile README.md PASTURESTACK_MAINTENANCE.md ORIGIN.md COMPATIBILITY.md \
    SECURITY.md trivy-secret.yaml package; then
    echo "ETCD_COMPAT_PRIVATE_OR_STAGING_REFERENCE_PRESENT" >&2
    exit 1
fi

if grep -R -Eioh 'ghcr\.io/[a-z0-9._-]+/' \
    Dockerfile README.md PASTURESTACK_MAINTENANCE.md ORIGIN.md COMPATIBILITY.md \
    SECURITY.md package | grep -Ev '^ghcr\.io/pasturestack/$' >/dev/null; then
    echo "ETCD_COMPAT_UNAPPROVED_REGISTRY_NAMESPACE_PRESENT" >&2
    exit 1
fi

if grep -R -Fq 'eval $1' package; then
    echo "ETCD_COMPAT_UNSAFE_COMMAND_DISPATCH_PRESENT" >&2
    exit 1
fi

if grep -R -Fq 'grpc.Errorf(codes.Internal, err.Error())' etcdserver/api/v3rpc; then
    echo "ETCD_COMPAT_NON_CONSTANT_GRPC_ERROR_FORMAT_PRESENT" >&2
    exit 1
fi

if ! grep -Fq 'strings.HasPrefix(endpoint, "unix://")' clientv3/client.go; then
    echo "ETCD_COMPAT_UNIX_ENDPOINT_COMPATIBILITY_MISSING" >&2
    exit 1
fi

if grep -R -Fq 'InsecureSkipVerify' package --exclude='*_test.go'; then
    echo "ETCD_COMPAT_INSECURE_TLS_VERIFICATION_PRESENT" >&2
    exit 1
fi

if grep -R -Eq '(^|[[:space:]])(-k|--insecure)([[:space:]]|$)' \
    package/platform-compat package/update-platform-ca; then
    echo "ETCD_COMPAT_INSECURE_CURL_PRESENT" >&2
    exit 1
fi

if grep -R -Eq 'package/rancher-legacy|/opt/rancher|update-rancher-ssl' \
    Dockerfile package; then
    echo "ETCD_COMPAT_OLD_MAINTAINED_PATH_PRESENT" >&2
    exit 1
fi

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git diff --check
fi

echo "ETCD_COMPAT_MIGRATION_VALIDATION_OK"
